# ==========================================================================
# DevBatista - configuração Apache
# URLs limpas (sem .html), canonicalização de domínio, cache e compressão.
# ==========================================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # 0. Bloqueio de robôs de IA
  #    a) Robôs de TREINO de IA: bloqueados no site inteiro.
  #       (Os de BUSCA por IA continuam liberados no site principal,
  #        para a DevBatista aparecer em respostas do ChatGPT, Claude etc.)
  # ----------------------------------------------------------------------
  #       As páginas bloqueadas passam pelo api/agente.php, que responde o
  #       mesmo 403 e só conta a tentativa no Admin (Acessos de IA →
  #       bloqueado). O resto (imagens, CSS, arquivos) é barrado direto.
  #       REDIRECT_STATUS vazio: só na requisição original, senão o próprio
  #       api/agente.php cairia no 403 do Apache.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ClaudeBot|anthropic-ai|CCBot|Bytespider|Amazonbot|meta-externalagent|meta-externalfetcher|FacebookBot|cohere-ai|cohere-training-data-crawler|Diffbot|ImagesiftBot|Omgilibot|Timpibot|AI2Bot|PanguBot) [NC]
  RewriteRule ^ - [E=DEVBATISTA_BLOQUEADO:1]

  RewriteCond %{ENV:DEVBATISTA_BLOQUEADO} =1
  RewriteRule ^$ api/agente.php?pagina=&bloqueado=1 [L]

  RewriteCond %{ENV:DEVBATISTA_BLOQUEADO} =1
  RewriteRule ^blog/$ api/agente.php?pagina=blog/index&bloqueado=1 [L]

  RewriteCond %{ENV:DEVBATISTA_BLOQUEADO} =1
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^((?:blog/)?[a-z0-9-]+)$ api/agente.php?pagina=$1&bloqueado=1 [L]

  RewriteCond %{ENV:DEVBATISTA_BLOQUEADO} =1
  RewriteRule ^ - [F,L]

  #    b) Área de previews: bloqueada também para robôs de BUSCA e para
  #       acessos de assistentes de IA feitos a pedido do usuário.
  RewriteCond %{HTTP_USER_AGENT} (OAI-SearchBot|ChatGPT-User|Claude-SearchBot|Claude-User|Claude-Web|PerplexityBot|Perplexity-User|Applebot|Google-CloudVertexBot|GoogleOther|YouBot|DuckAssistBot|MistralAI-User|Bingbot|Googlebot) [NC]
  RewriteRule ^previews/ - [F,L]

  # ----------------------------------------------------------------------
  # 1. Força HTTPS + domínio canônico (www)
  #    Hoje devbatista.com e www.devbatista.com respondem 200 nos dois,
  #    o que gera conteúdo duplicado para o Google.
  # ----------------------------------------------------------------------
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.devbatista.com%{REQUEST_URI} [R=301,L]

  # ----------------------------------------------------------------------
  # 2. Endereços antigos
  #    /servicos virou /solucoes. 301 de verdade (o servicos.html com
  #    meta refresh respondia 200 e o Google o tratava como página própria).
  # ----------------------------------------------------------------------
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^servicos(\.html)?/?$ /solucoes [R=301,L]

  # ----------------------------------------------------------------------
  # 3. Remove index / index.html (raiz e pastas, como /blog/) num salto só
  #    Antes, /index.html ia para /index e só depois para /.
  # ----------------------------------------------------------------------
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(.*/)?index(\.html)?$ /$1 [R=301,L]

  # ----------------------------------------------------------------------
  # 3a. Redireciona /pagina.html -> /pagina  (301, preserva o SEO)
  #     Só para requisições externas reais, nunca para rewrites internos.
  # ----------------------------------------------------------------------
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # ----------------------------------------------------------------------
  # 3b. Remove barra final de URLs que não são diretórios (/sobre/ -> /sobre)
  #     Precisa vir antes da regra 4: lá o padrão aceita a barra e servia
  #     /sobre/ com 200, uma cópia de /sobre.
  # ----------------------------------------------------------------------
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # ----------------------------------------------------------------------
  # 3c. Robôs e agentes de IA: a página passa pelo api/agente.php, que
  #     entrega o mesmo HTML e avisa o Admin (Visitas do site → Acessos de
  #     IA). Robô não roda JavaScript, então o js/visitas.js não o vê.
  #     Pessoas não passam por aqui: recebem o HTML estático, como sempre.
  #     A peneira é larga de propósito (quem classifica é o Admin), mas os
  #     buscadores comuns ficam de fora, para o SEO nunca depender do PHP.
  # ----------------------------------------------------------------------
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{HTTP_USER_AGENT} !(Googlebot|bingbot|YandexBot|Baiduspider|DuckDuckBot) [NC]
  RewriteCond %{HTTP:Signature-Agent} . [OR]
  RewriteCond %{HTTP_USER_AGENT} (bot|crawl|spider|-User|GPT|Claude|Perplexity|anthropic|openai|meta-external|MistralAI) [NC]
  RewriteRule ^ - [E=DEVBATISTA_AGENTE:1]

  RewriteCond %{ENV:DEVBATISTA_AGENTE} =1
  RewriteRule ^$ api/agente.php?pagina= [L]

  RewriteCond %{ENV:DEVBATISTA_AGENTE} =1
  RewriteRule ^blog/$ api/agente.php?pagina=blog/index [L]

  RewriteCond %{ENV:DEVBATISTA_AGENTE} =1
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^((?:blog/)?[a-z0-9-]+)$ api/agente.php?pagina=$1 [L]

  # ----------------------------------------------------------------------
  # 4. Serve /pagina a partir de pagina.html (rewrite interno, sem redirect)
  #    Vale também para /blog/slug-do-post -> blog/slug-do-post.html.
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ==========================================================================
# Página 404
# ==========================================================================
ErrorDocument 404 /404.html

# ==========================================================================
# Compressão
# ==========================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ==========================================================================
# Cache de estáticos
# ==========================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpe?g|ico|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Segurança básica
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ==========================================================================
# MIME types
# ==========================================================================
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>
