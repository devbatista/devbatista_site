# ==========================================================================
# DevBatista - configuração Apache
# URLs limpas (sem .html), canonicalização de domínio, cache e compressão.
# ==========================================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # 0. Bloqueio de robôs de IA
  #    a) Robôs de TREINO de IA: bloqueados no site inteiro.
  #       (Os de BUSCA por IA continuam liberados no site principal,
  #        para a DevBatista aparecer em respostas do ChatGPT, Claude etc.)
  # ----------------------------------------------------------------------
  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ClaudeBot|anthropic-ai|CCBot|Bytespider|Amazonbot|meta-externalagent|meta-externalfetcher|FacebookBot|cohere-ai|cohere-training-data-crawler|Diffbot|ImagesiftBot|Omgilibot|Timpibot|AI2Bot|PanguBot) [NC]
  RewriteRule ^ - [F,L]

  #    b) Área de previews: bloqueada também para robôs de BUSCA e para
  #       acessos de assistentes de IA feitos a pedido do usuário.
  RewriteCond %{HTTP_USER_AGENT} (OAI-SearchBot|ChatGPT-User|Claude-SearchBot|Claude-User|Claude-Web|PerplexityBot|Perplexity-User|Applebot|Google-CloudVertexBot|GoogleOther|YouBot|DuckAssistBot|MistralAI-User|Bingbot|Googlebot) [NC]
  RewriteRule ^previews/ - [F,L]

  # ----------------------------------------------------------------------
  # 1. Força HTTPS + domínio canônico (www)
  #    Hoje devbatista.com e www.devbatista.com respondem 200 nos dois,
  #    o que gera conteúdo duplicado para o Google.
  # ----------------------------------------------------------------------
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.devbatista.com%{REQUEST_URI} [R=301,L]

  # ----------------------------------------------------------------------
  # 2. Redireciona /pagina.html -> /pagina  (301, preserva o SEO)
  #    Só para requisições externas reais, nunca para rewrites internos.
  # ----------------------------------------------------------------------
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # ----------------------------------------------------------------------
  # 3. Remove index / index.html da raiz
  # ----------------------------------------------------------------------
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^index$ / [R=301,L]

  # ----------------------------------------------------------------------
  # 4. Serve /pagina a partir de pagina.html (rewrite interno, sem redirect)
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # ----------------------------------------------------------------------
  # 5. Remove barra final de URLs que não são diretórios (/sobre/ -> /sobre)
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
</IfModule>

# ==========================================================================
# Página 404
# ==========================================================================
ErrorDocument 404 /404.html

# ==========================================================================
# Compressão
# ==========================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ==========================================================================
# Cache de estáticos
# ==========================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpe?g|ico|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Segurança básica
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ==========================================================================
# MIME types
# ==========================================================================
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>
